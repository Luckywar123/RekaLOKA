+(function(){
+  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
+  var fine = matchMedia('(pointer:fine)').matches;
+  document.addEventListener('DOMContentLoaded', function(){
+    // progress bar + glass nav
+    var bar = document.createElement('div'); bar.id = 'rk-progress'; document.body.appendChild(bar);
+    var nav = document.getElementById('navbar');
+    function onScroll(){
+      var h = document.documentElement, max = h.scrollHeight - h.clientHeight;
+      bar.style.transform = 'scaleX(' + (max > 0 ? h.scrollTop / max : 0) + ')';
+      if (nav) nav.classList.toggle('rk-glass', h.scrollTop > 40);
+    }
+    addEventListener('scroll', onScroll, {passive:true}); onScroll();
+
+    // aurora di hero
+    var hero = document.getElementById('hero');
+    if (hero && !reduce){
+      var a = document.createElement('div'); a.className = 'rk-aurora'; a.innerHTML = '<i></i><i></i><i></i>';
+      var scrim = hero.querySelector('.hero-scrim'); hero.insertBefore(a, scrim ? scrim.nextSibling : hero.firstChild);
+    }
+
+    // cursor glow + spotlight + tilt (desktop saja)
+    if (fine && !reduce){
+      var g = document.createElement('div'); g.id = 'rk-glow'; document.body.appendChild(g);
+      addEventListener('mousemove', function(e){ g.style.left = e.clientX + 'px'; g.style.top = e.clientY + 'px'; document.body.classList.add('has-glow'); }, {passive:true});
+      document.body.addEventListener('mouseleave', function(){ document.body.classList.remove('has-glow'); });
+    }
+    var cards = document.querySelectorAll('.plate,.why-cell,.aud-cell,.case-card,.feature-item,.proc-step,.del-cell');
+    cards.forEach(function(c){
+      c.classList.add('rk-card');
+      var s = document.createElement('span'); s.className = 'rk-spot'; s.setAttribute('aria-hidden','true'); c.insertBefore(s, c.firstChild);
+      if (!fine || reduce) return;
+      c.addEventListener('mousemove', function(e){
+        var r = c.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
+        c.style.setProperty('--mx', x + 'px'); c.style.setProperty('--my', y + 'px');
+        c.style.transform = 'perspective(900px) rotateX(' + ((y / r.height - .5) * -5) + 'deg) rotateY(' + ((x / r.width - .5) * 6) + 'deg) translateY(-3px)';
+      });
+      c.addEventListener('mouseleave', function(){ c.style.transform = ''; });
+    });
+
+    // magnetic buttons
+    if (fine && !reduce) document.querySelectorAll('.btn-primary,.btn-ghost,.nav-cta').forEach(function(b){
+      b.addEventListener('mousemove', function(e){ var r = b.getBoundingClientRect();
+        b.style.transform = 'translate(' + ((e.clientX - r.left - r.width / 2) * .18) + 'px,' + ((e.clientY - r.top - r.height / 2) * .25) + 'px)'; });
+      b.addEventListener('mouseleave', function(){ b.style.transform = ''; });
+    });
+
+    // count-up angka statistik
+    var nums = document.querySelectorAll('.stats-strip .num');
+    if ('IntersectionObserver' in window && !reduce) {
+      var io = new IntersectionObserver(function(es){ es.forEach(function(en){
+        if (!en.isIntersecting) return; io.unobserve(en.target);
+        var el = en.target, m = el.textContent.match(/\d+/); if (!m) return;
+        var end = +m[0], t0 = performance.now(), pre = el.textContent.slice(0, m.index), suf = el.textContent.slice(m.index + m[0].length);
+        (function step(t){ var p = Math.min((t - t0) / 1200, 1);
+          el.textContent = pre + Math.round(end * (1 - Math.pow(1 - p, 3))) + suf; if (p < 1) requestAnimationFrame(step); })(t0);
+      }); }, {threshold:.6});
+      nums.forEach(function(n){ io.observe(n); });
+    }
+  });
+})();
diff --git a/js/security.js b/js/security.js
new file mode 100644
index 0000000..12e01bf
--- /dev/null
+++ b/js/security.js
@@ -0,0 +1,35 @@
+/* Anti-spam form: honeypot + time-trap + cooldown/rate limit klien.
+   Harus dimuat SEBELUM forms.js (listener capture-phase memblokir submit bot). */
+(function(){
+  var MIN_FILL_MS = 3000, COOLDOWN_MS = 60000, MAX_PER_HOUR = 3;
+  var loaded = Date.now();
+  function msg(form, text){
+    var el = form.querySelector('.form-msg'); if (!el) return;
+    el.textContent = (window.RK_I18N ? RK_I18N.t(text) : text);
+    el.style.color = '#D9534F'; el.style.display = 'block';
+  }
+  function log(key){ try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch(e){ return []; } }
+  function guard(form){
+    var key = 'rk_sub_' + form.id;
+    form.addEventListener('submit', function(e){
+      var hp = form.querySelector('input[name="website"]');
+      var tooFast = Date.now() - loaded < MIN_FILL_MS;
+      if ((hp && hp.value) || tooFast){            // bot: pura-pura sukses, data tidak dikirim
+        e.preventDefault(); e.stopImmediatePropagation();
+        form.reset(); return;
+      }
+      var now = Date.now(), hist = log(key).filter(function(t){ return now - t < 3600000; });
+      var last = hist[hist.length - 1] || 0;
+      if (hist.length >= MAX_PER_HOUR || now - last < COOLDOWN_MS){
+        e.preventDefault(); e.stopImmediatePropagation();
+        msg(form, 'Terlalu banyak percobaan. Coba lagi beberapa saat lagi.'); return;
+      }
+      hist.push(now); try { localStorage.setItem(key, JSON.stringify(hist)); } catch(err){}
+    }, true);
+  }
+  document.addEventListener('DOMContentLoaded', function(){
+    ['formKemitraan','formUlasan'].forEach(function(id){
+      var f = document.getElementById(id); if (f) guard(f);
+    });
+  });
+})();
diff --git a/supabase_hardening.sql b/supabase_hardening.sql
new file mode 100644
index 0000000..63cfde7
--- /dev/null
+++ b/supabase_hardening.sql
@@ -0,0 +1,48 @@
+-- =====================================================================
+-- RekaLOKA — Hardening (jalankan di Supabase SQL Editor)
+-- 1) Rate limit sisi server (client-side saja bisa dilewati bot)
+-- 2) Batas panjang field
+-- 3) Tutup kebocoran email/no_hp di tabel ulasan
+-- =====================================================================
+
+-- 1+2) Trigger: maks 5 submit / jam / IP, dan maks 3 / jam / email
+create or replace function public.rk_rate_limit() returns trigger
+language plpgsql security definer set search_path = public as $$
+declare
+  ip text := coalesce(
+    split_part(current_setting('request.headers', true)::json->>'x-forwarded-for', ',', 1), 'unknown');
+  n_ip int; n_mail int;
+begin
+  if length(new.nama) > 100 or length(new.email) > 150 or length(new.no_hp) > 30 then
+    raise exception 'Input terlalu panjang';
+  end if;
+  if tg_table_name = 'kemitraan' and length(new.keterangan) > 2000 then
+    raise exception 'Keterangan terlalu panjang';
+  end if;
+
+  new.ip_hash := md5(ip);
+  execute format('select count(*) from public.%I where ip_hash = $1 and created_at > now() - interval ''1 hour''', tg_table_name)
+    into n_ip using new.ip_hash;
+  execute format('select count(*) from public.%I where lower(email) = lower($1) and created_at > now() - interval ''1 hour''', tg_table_name)
+    into n_mail using new.email;
+
+  if n_ip >= 5 or n_mail >= 3 then
+    raise exception 'Terlalu banyak percobaan. Coba lagi nanti.' using errcode = 'P0001';
+  end if;
+  return new;
+end $$;
+
+alter table public.kemitraan add column if not exists ip_hash text;
+alter table public.ulasan    add column if not exists ip_hash text;
+
+drop trigger if exists rk_rl_kemitraan on public.kemitraan;
+create trigger rk_rl_kemitraan before insert on public.kemitraan
+  for each row execute function public.rk_rate_limit();
+
+drop trigger if exists rk_rl_ulasan on public.ulasan;
+create trigger rk_rl_ulasan before insert on public.ulasan
+  for each row execute function public.rk_rate_limit();
+
+-- 3) anon hanya boleh baca kolom rating (cukup untuk hitung rata-rata)
+revoke select on public.ulasan from anon;
+grant  select (rating, created_at) on public.ulasan to anon;
-- 
