--- /dev/null
+++ b/css/premium.css
@@ -0,0 +1,55 @@
+/* RekaLOKA — premium layer (aman dihapus: situs tetap jalan tanpa file ini) */
+#rk-progress{position:fixed;top:0;left:0;height:3px;width:100%;z-index:1000;transform-origin:0 50%;transform:scaleX(0);
+  background:linear-gradient(90deg,#3E7CB1,#2E9E6E,#C99A44);}
+#rk-glow{position:fixed;width:420px;height:420px;border-radius:50%;pointer-events:none;z-index:1;left:0;top:0;
+  background:radial-gradient(circle,rgba(62,124,177,.16),transparent 65%);transform:translate(-50%,-50%);opacity:0;transition:opacity .4s;mix-blend-mode:screen}
+body.has-glow #rk-glow{opacity:1}
+
+/* navbar glass */
+#navbar{transition:background .3s,backdrop-filter .3s,box-shadow .3s}
+#navbar.scrolled,#navbar.rk-glass{background:rgba(16,19,26,.72)!important;-webkit-backdrop-filter:saturate(160%) blur(14px);backdrop-filter:saturate(160%) blur(14px);box-shadow:0 1px 0 rgba(255,255,255,.08)}
+
+/* language switcher */
+.lang-switch{display:inline-flex;gap:2px;padding:3px;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:rgba(255,255,255,.06);margin-left:12px}
+.lang-btn{font:600 11px/1 var(--font-body);letter-spacing:.06em;color:#cfd4db;background:none;border:0;padding:7px 10px;border-radius:999px;cursor:pointer;transition:all .2s}
+.lang-btn:hover{color:#fff}
+.lang-btn.active{background:linear-gradient(135deg,#3E7CB1,#2E9E6E);color:#fff;box-shadow:0 2px 10px rgba(62,124,177,.45)}
+#mobile-menu .lang-switch{margin:18px 0 0;display:flex;justify-content:center}
+@media (max-width:900px){#navbar .lang-switch{margin-left:auto;margin-right:8px}}
+
+/* hero: aurora + grid + gradient headline */
+.rk-aurora{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1}
+.rk-aurora i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.5;will-change:transform;animation:rkFloat 18s ease-in-out infinite alternate}
+.rk-aurora i:nth-child(1){width:46vmax;height:46vmax;left:-12%;top:-20%;background:#3E7CB1}
+.rk-aurora i:nth-child(2){width:38vmax;height:38vmax;right:-10%;top:10%;background:#2E9E6E;animation-delay:-6s;opacity:.32}
+.rk-aurora i:nth-child(3){width:30vmax;height:30vmax;left:35%;bottom:-25%;background:#C99A44;animation-delay:-11s;opacity:.22}
+.rk-aurora::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);
+  background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse at 50% 40%,#000 20%,transparent 75%);mask-image:radial-gradient(ellipse at 50% 40%,#000 20%,transparent 75%)}
+@keyframes rkFloat{to{transform:translate3d(8vmax,6vmax,0) scale(1.15)}}
+#hero{position:relative}
+#hero .hero-inner{position:relative;z-index:2}
+#hero h1{background:linear-gradient(110deg,#fff 20%,#9cc4e8 45%,#7fd8b0 60%,#fff 85%);background-size:220% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:rkShine 7s linear infinite}
+@keyframes rkShine{to{background-position:-220% center}}
+
+/* kartu: spotlight + tilt */
+.rk-card{position:relative;transform-style:preserve-3d;transition:transform .25s ease,box-shadow .3s ease,border-color .3s}
+.rk-card:hover{box-shadow:0 18px 50px -18px rgba(62,124,177,.45);border-color:rgba(62,124,177,.55)}
+.rk-spot{position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .3s;
+  background:radial-gradient(320px circle at var(--mx,50%) var(--my,50%),rgba(62,124,177,.18),transparent 60%)}
+.rk-card:hover>.rk-spot{opacity:1}
+
+/* tombol */
+.btn-primary,.btn-ghost,.nav-cta{transition:transform .2s ease,box-shadow .3s ease}
+.btn-primary:hover{box-shadow:0 10px 30px -8px rgba(62,124,177,.7)}
+
+/* heading section: garis aksen gradien */
+.section-head h2{position:relative;padding-bottom:14px}
+.section-head h2::after{content:"";position:absolute;left:0;bottom:0;width:56px;height:3px;border-radius:3px;background:linear-gradient(90deg,#3E7CB1,#2E9E6E)}
+
+/* honeypot (disembunyikan dari manusia & screen reader) */
+.hp-wrap{position:absolute!important;left:-9999px!important;width:1px;height:1px;overflow:hidden;opacity:0}
+
+@media (prefers-reduced-motion:reduce){
+  .rk-aurora i,#hero h1{animation:none}.rk-card{transform:none!important}#rk-glow{display:none}
+}
+@media (hover:none){#rk-glow{display:none}}
