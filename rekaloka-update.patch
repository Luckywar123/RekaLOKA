+  function norm(s){ return s.replace(/\u00a0/g,' ').replace(/\s+/g,' ').trim(); }
+  var N = {}; Object.keys(D).forEach(function(k){ N[norm(k)] = D[k]; });
+  var store = new WeakMap(), attrStore = new WeakMap(), cur = 'id';
+  var ATTRS = ['placeholder','aria-label','title','alt'];
+
+  function tr(s, lang){
+    if (lang === 'id') return null;
+    var e = N[norm(s)]; return e ? e[idx[lang]] : null;
+  }
+  function apply(lang){
+    cur = lang;
+    var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
+      acceptNode: function(n){
+        var p = n.parentNode;
+        if (!p || /^(SCRIPT|STYLE|NOSCRIPT)$/.test(p.nodeName)) return NodeFilter.FILTER_REJECT;
+        if (p.closest && p.closest('#rk-chat, .chatbot, [data-no-i18n]')) return NodeFilter.FILTER_REJECT;
+        return n.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+      }
+    });
+    var n; while ((n = w.nextNode())) {
+      if (!store.has(n)) store.set(n, n.nodeValue);
+      var src = store.get(n), t = tr(src, lang);
+      if (lang === 'id') n.nodeValue = src;
+      else if (t) n.nodeValue = src.replace(src.trim(), t).replace(/\u00a0/g,' ');
+    }
+    document.querySelectorAll('[placeholder],[aria-label],[title],[alt]').forEach(function(el){
+      var o = attrStore.get(el) || {}; attrStore.set(el, o);
+      ATTRS.forEach(function(a){
+        if (!el.hasAttribute(a)) return;
+        if (!(a in o)) o[a] = el.getAttribute(a);
+        var t = tr(o[a], lang); el.setAttribute(a, lang === 'id' ? o[a] : (t || o[a]));
+      });
+    });
+    document.documentElement.lang = lang;
+    document.querySelectorAll('.lang-btn').forEach(function(b){
+      b.classList.toggle('active', b.dataset.lang === lang);
+      b.setAttribute('aria-pressed', b.dataset.lang === lang);
+    });
+    try { localStorage.setItem('rk_lang', lang); } catch(e){}
+  }
+  function set(lang){ if (LANGS.indexOf(lang) > -1) apply(lang); }
+
+  // pesan form (di-set oleh forms.js / security.js) ikut diterjemahkan
+  var busy = false;
+  function watchMsgs(){
+    document.querySelectorAll('.form-msg').forEach(function(m){
+      new MutationObserver(function(){
+        if (busy || cur === 'id') return;
+        var t = tr(m.textContent, cur);
+        if (t){ busy = true; m.textContent = t; busy = false; }
+      }).observe(m, {childList:true, characterData:true, subtree:true});
+    });
+  }
+
+  window.RK_I18N = { set: set, get: function(){ return cur; }, t: function(s){ return tr(s, cur) || s; } };
+
+  document.addEventListener('DOMContentLoaded', function(){
+    document.addEventListener('click', function(e){
+      var b = e.target.closest && e.target.closest('.lang-btn');
+      if (b){ e.preventDefault(); set(b.dataset.lang); }
+    });
+    watchMsgs();
+    var saved = 'id';
+    try { saved = localStorage.getItem('rk_lang') || ''; } catch(e){}
+    if (!saved){ var nl = (navigator.language || 'id').slice(0,2); saved = LANGS.indexOf(nl) > -1 ? nl : 'id'; }
+    if (saved !== 'id') apply(saved); else apply('id');
+  });
+})();
